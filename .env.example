# Telegram MTProto API credentials (from https://my.telegram.org)
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Telegram Bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Webhook URL for bot updates (optional, omit for local-only)
# WEBHOOK_URL=https://your-domain.com/webhook

# Database URL (default: sqlite+aiosqlite:///data/digest.db)
# DATABASE_URL=sqlite+aiosqlite:///data/digest.db
